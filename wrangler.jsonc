{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allmov2",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm install"
  },
  "rate_limiting": {
    "simple": {
      "period_sec": 60,
      "requests_per_period": 10000
    }
  },
  "logpush": {
    "enabled": true
  }
}
